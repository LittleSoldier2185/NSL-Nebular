    {
      "id": "api_lib",
      "type": "api",
      "name": "API — ห้องสมุด",
      "typeVersion": 1,
      "content": {
        "title": "Mini Library API",
        "version": "1.0.0",
        "baseUrl": "https://api.mini-library.example/v1",
        "endpoints": [
          {
            "id": "e_books_list",
            "method": "get",
            "path": "/books",
            "summary": "ค้นหาหนังสือ",
            "group": "books",
            "table": {
              "doc": "er_lib",
              "table": "books"
            },
            "fields": [],
            "responses": [
              {
                "status": 200,
                "example": "[{\"id\":1,\"isbn\":\"9786160000011\",\"title\":\"สี่แผ่นดิน\",\"copies\":2}]"
              }
            ]
          },
          {
            "id": "e_book_create",
            "method": "post",
            "path": "/books",
            "summary": "เพิ่มหนังสือ",
            "group": "books",
            "auth": true,
            "table": {
              "doc": "er_lib",
              "table": "books"
            },
            "fields": [
              {
                "id": "f1",
                "name": "isbn",
                "type": "string",
                "required": true,
                "column": {
                  "doc": "er_lib",
                  "table": "books",
                  "column": "books_isbn"
                }
              },
              {
                "id": "f2",
                "name": "title",
                "type": "string",
                "required": true,
                "column": {
                  "doc": "er_lib",
                  "table": "books",
                  "column": "books_title"
                }
              },
              {
                "id": "f3",
                "name": "category_id",
                "type": "integer",
                "required": true,
                "column": {
                  "doc": "er_lib",
                  "table": "books",
                  "column": "books_category_id"
                }
              },
              {
                "id": "f4",
                "name": "copies",
                "type": "integer",
                "column": {
                  "doc": "er_lib",
                  "table": "books",
                  "column": "books_copies"
                }
              }
            ],
            "responses": [
              {
                "status": 201
              },
              {
                "status": 409,
                "description": "ISBN ซ้ำ",
                "example": "{\"error\":\"isbn_taken\"}"
              }
            ]
          },
          {
            "id": "e_member_get",
            "method": "get",
            "path": "/members/{id}",
            "summary": "ข้อมูลสมาชิก",
            "group": "members",
            "auth": true,
            "table": {
              "doc": "er_lib",
              "table": "members"
            },
            "fields": [],
            "responses": [
              {
                "status": 200,
                "example": "{\"id\":1,\"full_name\":\"สมชาย ใจดี\",\"email\":\"somchai@example.com\"}"
              },
              {
                "status": 404,
                "example": "{\"error\":\"not_found\"}"
              }
            ]
          },
          {
            "id": "e_loan_create",
            "method": "post",
            "path": "/loans",
            "summary": "ยืมหนังสือ",
            "group": "loans",
            "auth": true,
            "table": {
              "doc": "er_lib",
              "table": "loans"
            },
            "fields": [
              {
                "id": "f5",
                "name": "member_id",
                "type": "integer",
                "required": true,
                "column": {
                  "doc": "er_lib",
                  "table": "loans",
                  "column": "loans_member_id"
                }
              },
              {
                "id": "f6",
                "name": "book_id",
                "type": "integer",
                "required": true,
                "column": {
                  "doc": "er_lib",
                  "table": "loans",
                  "column": "loans_book_id"
                }
              },
              {
                "id": "f7",
                "name": "due_at",
                "type": "string",
                "required": true,
                "column": {
                  "doc": "er_lib",
                  "table": "loans",
                  "column": "loans_due_at"
                },
                "description": "YYYY-MM-DD"
              }
            ],
            "responses": [
              {
                "status": 201,
                "description": "ยืมสำเร็จ"
              },
              {
                "status": 409,
                "description": "หนังสือไม่ว่าง หรือยืมครบ 3 เล่มแล้ว",
                "example": "{\"error\":\"not_available\"}"
              }
            ]
          },
          {
            "id": "e_loan_return",
            "method": "patch",
            "path": "/loans/{id}",
            "summary": "คืนหนังสือ",
            "group": "loans",
            "auth": true,
            "table": {
              "doc": "er_lib",
              "table": "loans"
            },
            "fields": [
              {
                "id": "f8",
                "name": "returned_at",
                "type": "string",
                "column": {
                  "doc": "er_lib",
                  "table": "loans",
                  "column": "loans_returned_at"
                }
              }
            ],
            "responses": [
              {
                "status": 200
              }
            ]
          },
          {
            "id": "e_overdue",
            "method": "get",
            "path": "/loans/overdue",
            "summary": "รายการค้างคืน",
            "group": "loans",
            "auth": true,
            "table": {
              "doc": "er_lib",
              "table": "loans"
            },
            "fields": [],
            "responses": [
              {
                "status": 200,
                "example": "[{\"loan_id\":7,\"member\":\"สมหญิง รักอ่าน\",\"title\":\"จักรวาลในเปลือกนัท\",\"days_late\":3}]"
              }
            ]
          }
        ]
      }
    }
  ],
  "links": []
}