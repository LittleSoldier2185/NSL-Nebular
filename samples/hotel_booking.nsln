    {
      "id": "api_main",
      "type": "api",
      "name": "API — ระบบจองห้องพัก",
      "folder": "f_api",
      "typeVersion": 1,
      "notes": [
        {
          "id": "n9",
          "kind": "question",
          "text": "ใช้ JWT หรือ session cookie? (โมบายล์แอปในอนาคตควรใช้ JWT)",
          "created": "2026-11-19T00:00:00.000Z"
        },
        {
          "id": "n10",
          "kind": "todo",
          "text": "เพิ่ม query สำหรับ /rooms/available (check_in, check_out, guests) เป็นพารามิเตอร์ตามสัญญา",
          "created": "2026-11-19T00:00:00.000Z"
        }
      ],
      "content": {
        "title": "Hotel Booking API",
        "version": "1.0.0",
        "baseUrl": "https://api.siam-residence.example/v1",
        "endpoints": [
          {
            "id": "e_register",
            "method": "post",
            "path": "/auth/register",
            "summary": "สมัครสมาชิก",
            "group": "auth",
            "table": {
              "doc": "er_main",
              "table": "users"
            },
            "fields": [
              {
                "id": "f1",
                "name": "full_name",
                "type": "string",
                "required": true,
                "column": {
                  "doc": "er_main",
                  "table": "users",
                  "column": "users_full_name"
                }
              },
              {
                "id": "f2",
                "name": "email",
                "type": "string",
                "required": true,
                "column": {
                  "doc": "er_main",
                  "table": "users",
                  "column": "users_email"
                }
              },
              {
                "id": "f3",
                "name": "phone",
                "type": "string",
                "column": {
                  "doc": "er_main",
                  "table": "users",
                  "column": "users_phone"
                }
              },
              {
                "id": "f4",
                "name": "password",
                "type": "string",
                "required": true,
                "description": "อย่างน้อย 8 ตัวอักษร (เก็บเป็น password_hash)"
              }
            ],
            "responses": [
              {
                "status": 201,
                "description": "สมัครสำเร็จ",
                "example": "{\"id\":3,\"full_name\":\"สมหญิง รักดี\",\"email\":\"somying@example.com\",\"role\":\"guest\"}"
              },
              {
                "status": 409,
                "description": "อีเมลนี้ถูกใช้แล้ว",
                "example": "{\"error\":\"email_taken\"}"
              },
              {
                "status": 422,
                "description": "ข้อมูลไม่ถูกต้อง",
                "example": "{\"error\":\"validation_failed\"}"
              }
            ]
          },
          {
            "id": "e_login",
            "method": "post",
            "path": "/auth/login",
            "summary": "เข้าสู่ระบบ",
            "group": "auth",
            "fields": [
              {
                "id": "f5",
                "name": "email",
                "type": "string",
                "required": true,
                "column": {
                  "doc": "er_main",
                  "table": "users",
                  "column": "users_email"
                }
              },
              {
                "id": "f6",
                "name": "password",
                "type": "string",
                "required": true
              }
            ],
            "responses": [
              {
                "status": 200,
                "description": "ได้โทเคน",
                "example": "{\"token\":\"demo-token\",\"expires_in\":3600}"
              },
              {
                "status": 401,
                "description": "อีเมลหรือรหัสผ่านไม่ถูกต้อง",
                "example": "{\"error\":\"invalid_credentials\"}"
              }
            ]
          },
          {
            "id": "e_me",
            "method": "get",
            "path": "/me",
            "summary": "ข้อมูลของฉัน",
            "group": "auth",
            "auth": true,
            "table": {
              "doc": "er_main",
              "table": "users"
            },
            "fields": [],
            "responses": [
              {
                "status": 200,
